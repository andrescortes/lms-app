# Identity service environment configuration.
# Copy to .env for local runs. Never commit real secrets.
# Values below are local examples, not hardcoded runtime defaults.

# Runtime environment name (e.g. local, staging, production).
APP_ENV=local

# HTTP listen port for the API server.
HTTP_PORT=8081

# Path to the isolated SQLite database file.
# Example only; the deployment environment supplies the real path.
DB_PATH=./data/identity.db
